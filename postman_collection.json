{
  "info": {
    "_postman_id": "schedula-appointment-lifecycle-collection",
    "name": "Schedula - Doctor Scheduling & Appointments API",
    "description": "Complete Postman Collection for Schedula Advanced Doctor Scheduling & Appointment Lifecycle System (Booking, Wave Token Assignment, Stream Slots, Patient/Doctor Cancellation, Patient Rescheduling, and Date Availability).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "doctorToken",
      "value": "YOUR_DOCTOR_JWT_TOKEN",
      "type": "string"
    },
    {
      "key": "patientToken",
      "value": "YOUR_PATIENT_JWT_TOKEN",
      "type": "string"
    },
    {
      "key": "doctorId",
      "value": "YOUR_DOCTOR_UUID",
      "type": "string"
    },
    {
      "key": "appointmentId",
      "value": "YOUR_APPOINTMENT_UUID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Authentication & Profiles",
      "item": [
        {
          "name": "0.1 Register Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) { pm.collectionVariables.set('doctorToken', jsonData.access_token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"stream.doctor@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Dr. Sarah Jenkins\",\n  \"phone\": \"1234567890\",\n  \"role\": \"doctor\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "0.2 Login Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) { pm.collectionVariables.set('doctorToken', jsonData.access_token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"stream.doctor@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "0.3 Create Doctor Profile (STREAM Strategy)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) { pm.collectionVariables.set('doctorId', jsonData.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"specialization\": \"Psychiatry\",\n  \"yearsOfExperience\": \"10 years\",\n  \"qualification\": \"MD, PhD\",\n  \"bio\": \"Specializing in mood disorders and psychotherapy.\",\n  \"schedulingType\": \"STREAM\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/doctor/profile", "host": ["{{baseUrl}}"], "path": ["doctor", "profile"] }
          }
        },
        {
          "name": "0.4 Register Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) { pm.collectionVariables.set('patientToken', jsonData.access_token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.patient@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"John Doe\",\n  \"phone\": \"9876543210\",\n  \"role\": \"patient\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "0.5 Login Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) { pm.collectionVariables.set('patientToken', jsonData.access_token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.patient@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "0.6 Create Patient Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"age\": 32,\n  \"gender\": \"Male\",\n  \"medicalHistory\": \"None\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/patient/profile", "host": ["{{baseUrl}}"], "path": ["patient", "profile"] }
          }
        }
      ]
    },
    {
      "name": "1. Doctor Availability Setup",
      "item": [
        {
          "name": "1.1 Create Custom Override (STREAM - 15m duration, 5m buffer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-08-15\",\n  \"startTime\": \"10:00 AM\",\n  \"endTime\": \"12:00 PM\",\n  \"schedulingType\": \"STREAM\",\n  \"slotDuration\": 15,\n  \"bufferTime\": 5,\n  \"isAvailable\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/doctor/availability/override", "host": ["{{baseUrl}}"], "path": ["doctor", "availability", "override"] }
          }
        },
        {
          "name": "1.2 Create Custom Override (WAVE - 5 Capacity)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-08-16\",\n  \"startTime\": \"10:00 AM\",\n  \"endTime\": \"11:00 AM\",\n  \"schedulingType\": \"WAVE\",\n  \"maxCapacity\": 5,\n  \"isAvailable\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/doctor/availability/override", "host": ["{{baseUrl}}"], "path": ["doctor", "availability", "override"] }
          }
        },
        {
          "name": "1.3 Query Availability for Date (STREAM)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/doctor/availability/date?date=2026-08-15&doctorId={{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["doctor", "availability", "date"],
              "query": [
                { "key": "date", "value": "2026-08-15" },
                { "key": "doctorId", "value": "{{doctorId}}" }
              ]
            }
          }
        },
        {
          "name": "1.4 Query Availability for Date (WAVE)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/doctor/availability/date?date=2026-08-16&doctorId={{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["doctor", "availability", "date"],
              "query": [
                { "key": "date", "value": "2026-08-16" },
                { "key": "doctorId", "value": "{{doctorId}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Appointment Booking & Queries",
      "item": [
        {
          "name": "2.1 Book STREAM Appointment (Exact Slot)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) { pm.collectionVariables.set('appointmentId', jsonData.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"date\": \"2026-08-15\",\n  \"startTime\": \"10:00 AM\",\n  \"endTime\": \"10:15 AM\",\n  \"schedulingType\": \"STREAM\",\n  \"reason\": \"Routine Consultation\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/appointments/book", "host": ["{{baseUrl}}"], "path": ["appointments", "book"] }
          }
        },
        {
          "name": "2.2 Book WAVE Appointment (Sequential Token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"date\": \"2026-08-16\",\n  \"startTime\": \"10:00 AM\",\n  \"endTime\": \"11:00 AM\",\n  \"schedulingType\": \"WAVE\",\n  \"reason\": \"General Checkup\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/appointments/book", "host": ["{{baseUrl}}"], "path": ["appointments", "book"] }
          }
        },
        {
          "name": "2.3 Get Logged-in Patient Appointments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": { "raw": "{{baseUrl}}/appointments/patient", "host": ["{{baseUrl}}"], "path": ["appointments", "patient"] }
          }
        },
        {
          "name": "2.4 Get Logged-in Doctor Appointments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": { "raw": "{{baseUrl}}/appointments/doctor", "host": ["{{baseUrl}}"], "path": ["appointments", "doctor"] }
          }
        }
      ]
    },
    {
      "name": "3. Cancellation & Rescheduling",
      "item": [
        {
          "name": "3.1 Patient Reschedule Appointment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newDate\": \"2026-08-15\",\n  \"newStartTime\": \"10:20 AM\",\n  \"newEndTime\": \"10:35 AM\",\n  \"schedulingType\": \"STREAM\",\n  \"reason\": \"Rescheduled due to personal conflict\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/appointments/{{appointmentId}}/reschedule", "host": ["{{baseUrl}}"], "path": ["appointments", "{{appointmentId}}", "reschedule"] }
          }
        },
        {
          "name": "3.2 Patient Cancel Appointment",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": { "raw": "{{baseUrl}}/appointments/{{appointmentId}}/cancel", "host": ["{{baseUrl}}"], "path": ["appointments", "{{appointmentId}}", "cancel"] }
          }
        },
        {
          "name": "3.3 Doctor Cancel Appointment",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": { "raw": "{{baseUrl}}/appointments/{{appointmentId}}/cancel", "host": ["{{baseUrl}}"], "path": ["appointments", "{{appointmentId}}", "cancel"] }
          }
        }
      ]
    }
  ]
}
