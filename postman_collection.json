        {
          "name": "0.1 Register Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 or 400', function () {",
                  "    pm.expect([201, 400]).to.include(pm.response.code);",
                  "});",
                  "var res = pm.response.json();",
                  "if (res.access_token) { pm.environment.set('doctorToken', res.access_token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Dr. Sarah Jenkins\",\n  \"phone\": \"1234567890\",\n  \"role\": \"doctor\"\n}"
