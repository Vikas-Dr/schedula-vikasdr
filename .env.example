# Database configuration
# For local development: Leave DB_TYPE unset to use SQLite automatically
# For production (Render + Neon PostgreSQL): Set DB_TYPE=postgres and fill in Neon credentials

DB_TYPE=postgres
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/schedula?sslmode=require

# Individual connection params (used when DATABASE_URL is not set)
DB_HOST=ep-xxxx.region.aws.neon.tech
DB_PORT=5432
DB_NAME=schedula
DB_USER=your_neon_user
DB_PASS=your_neon_password

# JWT Auth configuration
JWT_SECRET=replace-with-a-strong-random-secret-in-production

# Server
PORT=3000

# Node environment
NODE_ENV=production
