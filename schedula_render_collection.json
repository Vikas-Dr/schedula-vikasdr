            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{doctorToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"2026-08-16\",\n  \"startTime\": \"10:00 AM\",\n  \"endTime\": \"11:00 AM\",\n  \"schedulingType\": \"WAVE\",\n  \"maxCapacity\": 5,\n  \"isAvailable\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/doctor/availability/override",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doctor",
            "availability",
            "override"
          ]
        }
      },
      "response": []
    },
    {
      "name": "09. Query Stream Availability for Date",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{patientToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/doctor/availability/date?date=2026-08-15&doctorId={{doctorId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doctor",
            "availability",
            "date"
          ],
          "query": [
            {
              "key": "date",
              "value": "2026-08-15"
            },
            {
              "key": "doctorId",
              "value": "{{doctorId}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "10. Query Wave Availability for Date",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{patientToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/doctor/availability/date?date=2026-08-16&doctorId={{doctorId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doctor",
            "availability",
            "date"
          ],
          "query": [
            {
              "key": "date",
              "value": "2026-08-16"
            },
            {
              "key": "doctorId",
              "value": "{{doctorId}}"
            }
          ]
        }
      },
      "response": []
