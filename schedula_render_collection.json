    {
      "name": "07. Create Doctor STREAM Availability Window",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{doctorToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"2026-08-15\",\n  \"startTime\": \"10:00 AM\",\n  \"endTime\": \"12:00 PM\",\n  \"schedulingType\": \"STREAM\",\n  \"slotDuration\": 15,\n  \"bufferTime\": 5,\n  \"isAvailable\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/doctor/availability/override",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doctor",
            "availability",
            "override"
          ]
        }
      },
      "response": []
    },
    {
      "name": "08. Create Doctor WAVE Availability Window",
      "request": {
        "method": "POST",
        "header": [
