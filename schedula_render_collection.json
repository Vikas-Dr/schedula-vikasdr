          "listen": "test",
          "script": {
            "exec": [
              "var res = pm.response.json();",
              "if (res.id) {",
              "    pm.environment.set('appointmentId', res.id);",
              "    pm.collectionVariables.set('appointmentId', res.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{patientToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"date\": \"2026-08-15\",\n  \"startTime\": \"10:00 AM\",\n  \"endTime\": \"10:15 AM\",\n  \"reason\": \"Routine Consultation\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/appointments/book",
          "host": [
