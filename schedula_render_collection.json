            "value": "Bearer {{patientToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"age\": 32,\n  \"gender\": \"Male\",\n  \"medicalHistory\": \"None\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/patient/profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
