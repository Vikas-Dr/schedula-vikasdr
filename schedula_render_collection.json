        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03. Create Doctor Profile",
      "event": [
        {
          "listen": "test",
