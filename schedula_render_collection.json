{
  "info": {
    "_postman_id": "schedula-render-production-collection-v2",
    "name": "Schedula - Production Render Testing Collection",
    "description": "Clean, ready-to-run Postman collection for testing Schedula API on Render (https://schedula-vikasdr.onrender.com). Includes auto-token extraction, dynamic email generation for clean runs, health check, doctor & patient onboarding, stream/wave scheduling, appointment booking, rescheduling, and cancellation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://schedula-vikasdr.onrender.com",
      "type": "string"
    },
    {
      "key": "doctorEmail",
      "value": "doctor.test@example.com",
      "type": "string"
    },
    {
      "key": "patientEmail",
      "value": "patient.test@example.com",
      "type": "string"
    },
    {
      "key": "doctorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "patientToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "doctorId",
      "value": "",
      "type": "string"
    },
    {
      "key": "appointmentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00. Health Check (Verify Render Service)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "01. Register Doctor Account",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var randomEmail = 'doctor.' + Date.now() + '@example.com';",
              "pm.collectionVariables.set('doctorEmail', randomEmail);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var res = pm.response.json();",
              "if (res.access_token) {",
              "    pm.environment.set('doctorToken', res.access_token);",
              "    pm.collectionVariables.set('doctorToken', res.access_token);",
              "}",
              "if (res.email) {",
              "    pm.environment.set('doctorEmail', res.email);",
              "    pm.collectionVariables.set('doctorEmail', res.email);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"password123\",\n  \"name\": \"Dr. Sarah Jenkins\",\n  \"phone\": \"1234567890\",\n  \"role\": \"doctor\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02. Login Doctor",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var res = pm.response.json();",
