          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{doctorToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"specialization\": \"Cardiology\",\n  \"yearsOfExperience\": \"10 years\",\n  \"qualification\": \"MD, PhD\",\n  \"bio\": \"Specializing in preventive cardiology\",\n  \"schedulingType\": \"STREAM\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/doctor/profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doctor",
            "profile"
          ]
        }
      },
      "response": []
